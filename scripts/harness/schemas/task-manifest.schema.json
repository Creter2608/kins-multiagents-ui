{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskManifest",
  "description": "Schema for Autonomous Agent Benchmark Task Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "datasetId",
    "datasetVersion",
    "repositoryUrl",
    "baseCommit",
    "targetCommit",
    "sourceType",
    "sourceId",
    "license",
    "taskType",
    "weight",
    "commands",
    "hiddenAssertions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "repositoryUrl": {
      "type": "string"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "targetCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "sourceType": {
      "type": "string",
      "enum": ["commit", "issue"]
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "taskType": {
      "type": "string",
      "enum": ["f2p", "p2p"]
    },
    "weight": {
      "type": "number",
      "minimum": 0
    },
    "publicFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goldenBundleDigest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "containerImageDigest": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["argv", "timeoutMs"],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        },
        "additionalProperties": false
      }
    },
    "hiddenAssertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  },
  "additionalProperties": false
}
